<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SmartStudy Lock</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1F2A52;
    --navy-light:#2E3B6E;
    --sky:#4C7EFF;
    --amber:#FFB648;
    --amber-deep:#F4923C;
    --cream:#FBF8F2;
    --card:#FFFFFF;
    --coral:#FF6F5E;
    --mint:#3FAE7C;
    --ink:#232323;
    --ink-soft:#6B7080;
    --line:#E7E2D8;
    --radius:18px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    background:
      radial-gradient(circle at 8% 12%, rgba(76,126,255,0.08), transparent 40%),
      radial-gradient(circle at 92% 85%, rgba(255,182,72,0.12), transparent 40%),
      var(--cream);
    color:var(--ink);
    min-height:100vh;
  }
  h1,h2,h3,.brand{font-family:'Fredoka',sans-serif;}
  button{font-family:'Inter',sans-serif;cursor:pointer;}
  .app{max-width:1180px;margin:0 auto;padding:28px 20px 60px;position:relative;}

  /* ---------- Language switcher ---------- */
  .lang-switch{position:fixed;top:18px;right:20px;z-index:50;}
  .lang-switch select{
    appearance:none;-webkit-appearance:none;
    padding:8px 30px 8px 14px;border-radius:999px;border:1px solid var(--line);
    background:#fff url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="10" height="6"><path d="M0 0l5 6 5-6z" fill="%236B7080"/></svg>') no-repeat right 12px center;
    font-size:13px;font-weight:600;color:var(--navy);cursor:pointer;font-family:'Inter';
    box-shadow:0 6px 16px -8px rgba(31,42,82,0.25);
  }

  /* ---------- Header ---------- */
  .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;padding-right:130px;}
  .brand{display:flex;align-items:center;gap:12px;font-size:22px;font-weight:600;color:var(--navy);}
  .brand .app-logo{width:40px;height:40px;border-radius:12px;object-fit:cover;box-shadow:0 4px 10px rgba(31,42,82,0.15);}
  .who{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-soft);flex-wrap:wrap;}
  .pill{padding:6px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:13px;font-weight:500;color:var(--navy);cursor:pointer;transition:.15s;}
  .pill:hover{border-color:var(--sky);color:var(--sky);}
  .pill.active{background:var(--navy);color:#fff;border-color:var(--navy);}

  /* ---------- Login ---------- */
  .center-stage{min-height:70vh;display:flex;align-items:center;justify-content:center;}
  .login-card{background:var(--card);border-radius:24px;padding:44px 40px;width:100%;max-width:420px;box-shadow:0 20px 50px -20px rgba(31,42,82,0.25);text-align:center;}
  .login-card .app-logo-large{width:120px;height:120px;border-radius:20px;object-fit:cover;margin:0 auto 18px;box-shadow:0 8px 20px rgba(31,42,82,0.2);}
  .login-card h1{font-size:24px;margin:0 0 6px;color:var(--navy);}
  .login-card p{color:var(--ink-soft);font-size:14px;margin:0 0 28px;line-height:1.5;}
  .auth-btn{width:100%;display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:12px;border:1px solid var(--line);background:#fff;font-size:14px;font-weight:500;margin-bottom:10px;transition:.15s;text-align:left;}
  .auth-btn:hover{border-color:var(--sky);background:#F7FAFF;}
  .auth-icon{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0;}
  .icon-g{background:#EA4335;}
  .icon-f{background:#1877F2;}
  .icon-m{background:#00A4EF;}
  .icon-p{background:var(--mint);}
  .phone-input{display:none;gap:8px;margin-top:10px;}
  .phone-input input{flex:1;padding:11px 12px;border-radius:10px;border:1px solid var(--line);font-size:14px;font-family:'Inter';}
  .phone-input button{padding:11px 16px;border-radius:10px;border:none;background:var(--navy);color:#fff;font-weight:600;font-size:14px;}

  /* ---------- Role select ---------- */
  .role-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:640px;width:100%;}
  .role-card{background:var(--card);border-radius:20px;padding:32px 24px;text-align:center;border:2px solid transparent;transition:.15s;box-shadow:0 12px 30px -18px rgba(31,42,82,0.2);}
  .role-card:hover{border-color:var(--sky);transform:translateY(-2px);}
  .role-card .ico{font-size:38px;margin-bottom:12px;}
  .role-card h3{margin:0 0 6px;color:var(--navy);font-size:19px;}
  .role-card p{margin:0;font-size:13px;color:var(--ink-soft);line-height:1.5;}

  /* ---------- Layout ---------- */
  .layout{display:grid;grid-template-columns:1fr;gap:24px;}
  .grid2{display:grid;grid-template-columns:1.3fr 1fr;gap:22px;align-items:start;}
  @media(max-width:900px){.grid2{grid-template-columns:1fr;} .topbar{padding-right:0;flex-direction:column;align-items:flex-start;gap:12px;} .lang-switch{position:static;margin-bottom:16px;}}

  .card{background:var(--card);border-radius:var(--radius);padding:24px;box-shadow:0 10px 26px -20px rgba(31,42,82,0.3);border:1px solid var(--line);}
  .card h2{font-size:17px;margin:0 0 4px;color:var(--navy);}
  .card .sub{font-size:12.5px;color:var(--ink-soft);margin:0 0 18px;}
  label{display:block;font-size:12.5px;font-weight:600;color:var(--navy);margin-bottom:6px;}
  input[type=time],input[type=number],input[type=text],select{
    width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--line);font-size:14px;font-family:'Inter';background:#FDFCFA;
  }
  .row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
  .toggle-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .switch{position:relative;width:44px;height:25px;flex-shrink:0;}
  .switch input{opacity:0;width:0;height:0;}
  .slider{position:absolute;inset:0;background:#DADFE8;border-radius:999px;transition:.2s;cursor:pointer;}
  .slider:before{content:"";position:absolute;width:19px;height:19px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;}
  .switch input:checked + .slider{background:var(--mint);}
  .switch input:checked + .slider:before{transform:translateX(19px);}

  .chip-input{display:flex;gap:8px;margin-bottom:10px;}
  .chip-input input{flex:1;}
  .chip-input button{padding:0 16px;border-radius:10px;border:none;background:var(--sky);color:#fff;font-weight:600;font-size:13px;}
  .chips{display:flex;flex-wrap:wrap;gap:8px;}
  .chip{background:#EFF3FF;color:var(--navy);padding:6px 10px 6px 12px;border-radius:999px;font-size:12.5px;display:flex;align-items:center;gap:8px;font-weight:500;}
  .chip button{background:none;border:none;color:var(--ink-soft);font-size:14px;line-height:1;}

  /* Subject grouping styles */
  .subject-section{margin-bottom:18px;border:1px solid var(--line);border-radius:12px;padding:14px;background:#FAFAFC;}
  .subject-title{font-size:14px;font-weight:700;color:var(--sky);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;}
  
  .qitem{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fff;}
  .qitem .qtext{font-weight:600;font-size:13.5px;margin-bottom:6px;color:var(--ink);}
  .qopts{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:4px;}
  .qopt{font-size:12px;padding:5px 8px;border-radius:6px;background:#F5F4F0;color:var(--ink-soft);}
  .qopt.correct{background:#E4F6EC;color:var(--mint);font-weight:600;}
  .qitem-foot{display:flex;justify-content:flex-end;}
  .qitem-foot button{background:none;border:none;color:var(--coral);font-size:12px;font-weight:600;}

  .btn-primary{width:100%;padding:12px;border-radius:12px;border:none;background:var(--navy);color:#fff;font-weight:600;font-size:14px;margin-top:4px;}
  .btn-primary:hover{background:var(--navy-light);}

  .newq-opt{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
  .newq-opt input[type=radio]{accent-color:var(--mint);width:16px;height:16px;}
  .newq-opt input[type=text]{flex:1;}

  .status-card{display:flex;align-items:center;gap:14px;}
  .status-dot{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
  .status-dot.locked{background:#FFEFE3;color:var(--amber-deep);}
  .status-dot.unlocked{background:#E4F6EC;color:var(--mint);}
  .status-text b{display:block;font-size:14.5px;color:var(--navy);}
  .status-text span{font-size:12.5px;color:var(--ink-soft);}

  /* ---------- Phone mock ---------- */
  .phone-wrap{display:flex;flex-direction:column;align-items:center;gap:16px;position:sticky;top:20px;}
  .phone{width:290px;height:590px;background:var(--navy);border-radius:38px;padding:12px;box-shadow:0 30px 60px -25px rgba(31,42,82,0.5);position:relative;}
  .phone .notch{position:absolute;top:12px;left:50%;transform:translateX(-50%);width:110px;height:20px;background:var(--navy);border-radius:0 0 14px 14px;z-index:3;}
  .screen{background:#fff;width:100%;height:100%;border-radius:28px;overflow:hidden;position:relative;display:flex;flex-direction:column;}

  .lockscreen{flex:1;background:linear-gradient(160deg,var(--navy) 0%,#141B38 100%);color:#fff;display:flex;flex-direction:column;align-items:center;padding:44px 22px 26px;text-align:center;}
  .lockscreen .lockicon{width:52px;height:52px;border-radius:16px;background:rgba(255,182,72,0.18);display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:14px;color:var(--amber);}
  .lockscreen h3{margin:0 0 4px;font-size:16px;font-family:'Fredoka';}
  .lockscreen p{margin:0 0 22px;font-size:12px;opacity:0.75;line-height:1.5;}
  .qcard{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);border-radius:16px;padding:16px;width:100%;text-align:left;}
  .qcard .qlabel{font-size:10.5px;text-transform:none;color:var(--amber);font-weight:600;margin-bottom:6px;}
  .qcard .qtext{font-size:14px;font-weight:600;margin-bottom:14px;line-height:1.4;}
  .qcard .opt{width:100%;text-align:left;padding:10px 12px;border-radius:10px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:#fff;font-size:12.5px;margin-bottom:8px;transition:.15s;}
  .qcard .opt:hover{background:rgba(255,255,255,0.16);}
  .opt.right{background:var(--mint) !important;border-color:var(--mint) !important;}
  .opt.wrong{background:var(--coral) !important;border-color:var(--coral) !important;}
  .feedback{font-size:12px;margin-top:10px;min-height:16px;font-weight:600;}
  .feedback.ok{color:var(--mint);}
  .feedback.bad{color:#FFB2AA;}

  .homescreen{flex:1;background:linear-gradient(160deg,#FFF7EA,#FFEFE0);display:flex;flex-direction:column;align-items:center;padding:40px 20px 20px;text-align:center;}
  .homescreen .badge{background:var(--mint);color:#fff;font-size:11px;font-weight:700;padding:5px 12px;border-radius:999px;margin-bottom:14px;}
  .homescreen h3{margin:0 0 6px;color:var(--navy);font-family:'Fredoka';font-size:17px;}
  .homescreen .timer{font-size:34px;font-weight:700;color:var(--amber-deep);font-family:'Fredoka';margin:10px 0 4px;}
  .homescreen p{font-size:12px;color:var(--ink-soft);margin:0 0 18px;}
  .applist{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%;margin-top:auto;}
  .appicon{aspect-ratio:1;background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 6px 14px -8px rgba(0,0,0,0.15);}

  .simbar{display:flex;gap:10px;}
  .simbar button{flex:1;padding:9px;border-radius:10px;border:1px solid var(--line);background:#fff;font-size:12.5px;font-weight:600;color:var(--navy);}
  .simbar button:hover{border-color:var(--sky);color:var(--sky);}

  .empty{font-size:12.5px;color:var(--ink-soft);text-align:center;padding:20px 0;}
  .hidden{display:none !important;}
  .footnote{text-align:center;font-size:11.5px;color:var(--ink-soft);margin-top:26px;}
</style>
</head>
