              <div class="subject-section">
                <div class="subject-title"><span>📚 ${getSubjectName(subj)}</span> <span style="font-size:11px;background:#E7EEFF;color:var(--sky);padding:2px 8px;border-radius:999px;">${list.length}</span></div>
                ${list.map(q=>`
                  <div class="qitem">
                    <div class="qtext">${qText(q)}</div>
                    <div class="qopts">
                      ${q.options.map((o,i)=>`<div class="qopt ${i===q.correct?'correct':''}">${o}</div>`).join('')}
                    </div>
                    <div class="qitem-foot"><button class="delQ" data-id="${q.id}">${t('remove')}</button></div>
                  </div>`).join('')}
              </div>`;
          }).join('') || `<div class="empty">${t('noQuestions')}</div>`}
        </div>
      </div>
    </div>
  </div>`;
}

function attachGuardian(){
  document.getElementById('saveSchedule').addEventListener('click', async ()=>{
    data.schedule.enabled = document.getElementById('schedEnabled').checked;
    data.schedule.start = document.getElementById('startTime').value || data.schedule.start;
    data.schedule.end = document.getElementById('endTime').value || data.schedule.end;
    data.rewardMinutes = parseInt(document.getElementById('rewardMin').value) || data.rewardMinutes;
    await saveData(); render();
  });
  document.getElementById('addApp').addEventListener('click', async ()=>{
    const inp = document.getElementById('newApp');
    if(inp.value.trim()){
      data.blockedApps.push(inp.value.trim());
      await saveData(); render();
    }
  });
  document.querySelectorAll('.rmApp').forEach(b=>{
    b.addEventListener('click', async ()=>{
      data.blockedApps.splice(parseInt(b.dataset.idx),1);
      await saveData(); render();
    });
  });
  document.getElementById('addQuestion').addEventListener('click', async ()=>{
    const subject = document.getElementById('newQSubject').value;
    const text = document.getElementById('newQText').value.trim();
    const opts = Array.from(document.querySelectorAll('.qopttext')).map(i=>i.value.trim());
    const corr = parseInt(document.querySelector('input[name=corr]:checked').value);
    if(!text || opts.some(o=>!o)){ return; }
    const id = data.questions.length ? Math.max(...data.questions.map(q=>q.id))+1 : 1;
    data.questions.push({ id, subject, textByLang:{ [currentLang]: text, en: text }, options:opts, correct:corr });
    await saveData(); render();
  });
  document.querySelectorAll('.delQ').forEach(b=>{
    b.addEventListener('click', async ()=>{
      data.questions = data.questions.filter(q=>q.id!==parseInt(b.dataset.id));
      await saveData(); render();
    });
  });
}

function childView(){
  const locked = isLockedNow();
  let screenHtml;
  if(locked){
    const q = pickQuestion();
    const subjectBadge = q ? getSubjectName(q.subject || 'Math') : '';
    screenHtml = q ? `
      <div class="lockscreen">
        <div class="notch"></div>
        <div class="lockicon">🔒</div>
        <h3>${t('lockedTitle')}</h3>
        <p>${t('lockedDesc')}</p>
        <div class="qcard">
          <div class="qlabel">${t('questionTag')} · <span style="color:var(--sky);background:#fff;padding:2px 6px;border-radius:4px;">${subjectBadge}</span></div>
          <div class="qtext">${qText(q)}</div>
          ${q.options.map((o,i)=>`<button class="opt" data-idx="${i}" data-correct="${q.correct}">${o}</button>`).join('')}
          <div class="feedback" id="feedback"></div>
        </div>
      </div>` : `
      <div class="lockscreen">
        <div class="notch"></div>
        <div class="lockicon">🔒</div>
        <h3>${t('lockedTitle')}</h3>
        <p>${t('noQuestionDesc')}</p>
      </div>`;
  } else {
    const remaining = data.session.unlockedUntil ? data.session.unlockedUntil - Date.now() : null;
    screenHtml = `
      <div class="homescreen">
        <div class="notch"></div>
        <div class="badge">${t('unlockedBadge')}</div>
        <h3>${t('correctTitle')}</h3>
        ${remaining ? `<div class="timer" id="timerDisplay">${fmtCountdown(remaining)}</div><p>${t('bonusTimeLeft')}</p>` : `<p>${t('freeUse')}</p>`}
        <div class="applist">
          ${data.blockedApps.slice(0,8).map(a=>`<div class="appicon" title="${a}">📲</div>`).join('') || ''}
        </div>
      </div>`;
  }

  return `
  <div class="phone-wrap">
    <div class="phone"><div class="screen">${screenHtml}</div></div>
    <div class="card" style="width:290px;">
      <h2 style="font-size:14px;">${t('simTitle')}</h2>
      <p class="sub">${t('simDesc')}</p>
      <div class="simbar">
        <button id="forceLock">${t('lockNow')}</button>
        <button id="forceUnlock">${t('removeLock')}</button>
      </div>
    </div>
  </div>`;
}

function attachChild(){
  document.querySelectorAll('.qcard .opt').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const idx = parseInt(btn.dataset.idx);
      const correct = parseInt(btn.dataset.correct);
      const fb = document.getElementById('feedback');
      document.querySelectorAll('.qcard .opt').forEach(b=>b.disabled=true);
      if(idx===correct){
        btn.classList.add('right');
        fb.textContent = t('correctFeedback').replace('{n}', data.rewardMinutes);
        fb.className = 'feedback ok';
        data.session.unlockedUntil = Date.now() + data.rewardMinutes*60000;
        data.session.forceLocked = false;
        await saveData();
        setTimeout(render, 900);
      } else {
        btn.classList.add('wrong');
        fb.textContent = t('wrongFeedback');
        fb.className = 'feedback bad';
        setTimeout(render, 1100);
      }
    });
  });

  document.getElementById('forceLock').addEventListener('click', async ()=>{
    data.session.forceLocked = true;
    data.session.unlockedUntil = null;
    await saveData(); render();
  });
  document.getElementById('forceUnlock').addEventListener('click', async ()=>{
    data.session.forceLocked = false;
    data.session.unlockedUntil = Date.now() + data.rewardMinutes*60000;
    await saveData(); render();
  });

  if(!isLockedNow() && data.session.unlockedUntil){
    if(window._sslTick) clearInterval(window._sslTick);
    window._sslTick = setInterval(()=>{
      const el = document.getElementById('timerDisplay');
      if(!el){ clearInterval(window._sslTick); return; }
      const remaining = data.session.unlockedUntil - Date.now();
      if(remaining<=0){ clearInterval(window._sslTick); render(); return; }
      el.textContent = fmtCountdown(remaining);
    },1000);
  }
}

(async function init(){
  await loadData();
  render();
})();
</script>
</body>
</html>
