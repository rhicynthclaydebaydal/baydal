async function loadData(){
  try{
    const res = await window.storage.get('ssl_data', true);
    if(res && res.value){ data = JSON.parse(res.value); }
  }catch(e){}
}
async function saveData(){
  try{
    await window.storage.set('ssl_data', JSON.stringify(data), true);
  }catch(e){ storageOk = false; }
}

function pad(n){return n.toString().padStart(2,'0');}
function nowHM(){ const d=new Date(); return pad(d.getHours())+":"+pad(d.getMinutes()); }
function inWindow(start,end,cur){
  if(start<=end) return cur>=start && cur<end;
  return cur>=start || cur<end;
}
function isLockedNow(){
  if(data.session.unlockedUntil && Date.now() < data.session.unlockedUntil) return false;
  if(data.session.unlockedUntil && Date.now() >= data.session.unlockedUntil){ data.session.unlockedUntil = null; }
  if(data.session.forceLocked) return true;
  if(!data.schedule.enabled) return false;
  return inWindow(data.schedule.start, data.schedule.end, nowHM());
}
function pickQuestion(){
  if(data.questions.length===0) return null;
  const q = data.questions[Math.floor(Math.random()*data.questions.length)];
  currentQuestionId = q.id;
  return q;
}
function qText(q){
  if(q.textByLang) return q.textByLang[currentLang] || q.textByLang.en || q.text || '';
  return q.text || '';
}
function fmtCountdown(ms){
  const s = Math.max(0,Math.floor(ms/1000));
  const m = Math.floor(s/60), sec = s%60;
  return pad(m)+":"+pad(sec);
}

